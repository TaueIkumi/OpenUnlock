{
  "name": "openunlock",
  "version": "0.1.1",
  "description": "Universal import/export infrastructure for SaaS data. FFmpeg for SaaS exports.",
  "license": "MIT",
  "author": "Ikumi Taue",
  "homepage": "https://github.com/TaueIkumi/openunlock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaueIkumi/openunlock.git"
  },
  "bugs": {
    "url": "https://github.com/TaueIkumi/openunlock/issues"
  },
  "keywords": [
    "data-portability",
    "export",
    "migration",
    "chatgpt",
    "notion",
    "slack",
    "obsidian",
    "cli"
  ],
  "type": "module",
  "bin": {
    "openunlock": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/cli/index.js",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-xml-parser": "4.5.7",
    "sanitize-html": "^2.17.7",
    "yauzl": "^3.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=18"
  }
}
